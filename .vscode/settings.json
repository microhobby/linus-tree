{
    "kerneldev.kgdb_port": "2424",
    "kerneldev.serial_port": "2525",
    "kerneldev.serial_dev": "ttyACM0",
    "kerneldev.serial_baudRate": "115200",
    "kerneldev.breakBySysrq": "serial",
    "window.title": "Linux Gaia",
    "window.x": 25,
    "window.y": 20,
    "window.width": 1881,
    "window.height": 2058,
    "workbench.sideBar.location": "left",
    "ctags.languages": [
        "c",
        "asm"
    ],
    "kerneldev.useDocker": false,
    "devicetree.bindings": [
        "${workspaceFolder}/Documentation/devicetree/bindings"
    ],
    "checkpatch.checkpatchPath": "./scripts/checkpatch.pl",
    "kconfig.env": {
        "SRCARCH": "x86"
    },
    "kerneldev.experimental.newDtsEngine": true,
    "kerneldev.experimental.newKconfigEngine": true,
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.intelliSenseCachePath": "${workspaceFolder}/.vscode/",
    // "C_Cpp.intelliSenseEngine": "Tag Parser",
    "C_Cpp.enhancedColorization": "enabled",
    "files.associations": {
        "Dockerfile*": "dockerfile",
        "Containerfile*": "dockerfile",
        "docker-compose*": "yaml",
        "*_defconfig": "defconfig",
        "defconfig": "defconfig",
        "*.scr": "shellscript",
        "*.build": "powershell",
        "*.run": "powershell",
        "*COMMIT_EDITMSG*": "git-commit",
        ".wslconfig": "ini",
        "*.defs": "makefile",
        "*.ld": "linkerscript",
        "fb.h": "c",
        "kgdb.h": "c",
        "notifier.h": "c",
        "srcu.h": "c",
        "rcupdate.h": "c",
        "rcu_segcblist.h": "c",
        "workqueue.h": "c",
        "timer.h": "c",
        "stringify.h": "c",
        "ktime.h": "c",
        "jiffies.h": "c",
        "module.h": "c",
        "elf.h": "c",
        "sched.h": "c",
        "seccomp.h": "c",
        "unistd.h": "c",
        "compiler_types.h": "c",
        "fbcon.h": "c",
        "irq.h": "c",
        "vt_kern.h": "c",
        "kd.h": "c",
        "types.h": "c",
        "selection.h": "c",
        "string.h": "c",
        "fs.h": "c",
        "slab.h": "c",
        "uaccess.h": "c",
        "crc32.h": "c",
        "interrupt.h": "c",
        "init.h": "c",
        "console.h": "c",
        "fcntl.h": "c"
    },
}
